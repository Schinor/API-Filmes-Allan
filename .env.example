DATABASE_URL=Sua_URL
# API TMDB — chave do tipo "Bearer Token" (API Read Access Token)
TMDB_API_KEY=
TMDB_BASE_URL=

# JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Porta do servidor (use a porta reservada do aluno no Portainer)
PORT=8000